<Window x:Class="ValoTools.Dashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ValoTools" Icon="assets/ValoTools.ico" Width="1260" Height="810" MinWidth="1020" MinHeight="650"
        WindowStartupLocation="CenterScreen" Background="#08090B" Foreground="#F4F5F6"
        FontFamily="./assets/fonts/#Figtree" Loaded="Window_Loaded" Closing="Window_Closing" SourceInitialized="Window_SourceInitialized">
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#36B7C1"/>
        <SolidColorBrush x:Key="Muted" Color="#85878D"/>
        <CubicEase x:Key="SmoothEase" EasingMode="EaseOut"/>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#17181D"/>
            <Setter Property="BorderBrush" Value="#292B30"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                    <Setter Property="Background" Value="#142629"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1" ScaleY="1"/></Setter.Value></Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="24" Padding="20,12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.035" Duration="0:0:0.18" EasingFunction="{StaticResource SmoothEase}"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.035" Duration="0:0:0.18" EasingFunction="{StaticResource SmoothEase}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.22" EasingFunction="{StaticResource SmoothEase}"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.22" EasingFunction="{StaticResource SmoothEase}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AgentButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F4F5F6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1" ScaleY="1"/></Setter.Value></Setter>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><ContentPresenter/></ControlTemplate></Setter.Value></Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.055" Duration="0:0:0.18" EasingFunction="{StaticResource SmoothEase}"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.055" Duration="0:0:0.18" EasingFunction="{StaticResource SmoothEase}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.24" EasingFunction="{StaticResource SmoothEase}"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.24" EasingFunction="{StaticResource SmoothEase}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RefreshButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="94"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="8" BorderThickness="1">
                            <Border.Background><SolidColorBrush Color="#181B20"/></Border.Background>
                            <Border.BorderBrush><SolidColorBrush Color="#343941"/></Border.BorderBrush>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Width="16" Height="16" Stretch="Uniform" Stroke="#60C5CD" StrokeThickness="1.7"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M 14.8,7.1 A 5.7,5.7 0 0 0 4.2,6.1 M 4.2,3.7 L 4.2,6.5 L 7,6.5 M 3.2,10.9 A 5.7,5.7 0 0 0 13.8,11.9 M 13.8,14.3 L 13.8,11.5 L 11,11.5"/>
                                <TextBlock Text="YENİLE" Foreground="#D4DEE1" FontSize="10.5" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Surface" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#1B3035" Duration="0:0:0.16"/>
                                        <ColorAnimation Storyboard.TargetName="Surface" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#43848B" Duration="0:0:0.16"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Surface" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#181B20" Duration="0:0:0.2"/>
                                        <ColorAnimation Storyboard.TargetName="Surface" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#343941" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.78"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#60C5CD"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RoleChip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#A7ADB4"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chip" Background="#17191E" BorderBrush="#30343A"
                                BorderThickness="1" CornerRadius="7" Padding="5,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="#1E292D"/>
                                <Setter TargetName="Chip" Property="BorderBrush" Value="#48747A"/>
                                <Setter Property="Foreground" Value="#E3F4F5"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="#183237"/>
                                <Setter TargetName="Chip" Property="BorderBrush" Value="#3B929A"/>
                                <Setter Property="Foreground" Value="#DBFAFC"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="#6DD5DD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModernScrollThumb" TargetType="Thumb">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Grip" Background="#4B4D55" CornerRadius="4" Margin="2,2,2,2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="#36B7C1"/></Trigger>
                            <Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Background" Value="#79D8DF"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModernScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True"
                                   Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                   Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                   ViewportSize="{TemplateBinding ViewportSize}">
                                <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPageButton}"/></Track.DecreaseRepeatButton>
                                <Track.Thumb><Thumb Style="{StaticResource ModernScrollThumb}"/></Track.Thumb>
                                <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPageButton}"/></Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="MainStage" Opacity="0">
        <Grid.RenderTransform><TranslateTransform Y="18"/></Grid.RenderTransform>
        <Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Margin="18,22,14,20">
            <Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="1"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                <Image Source="assets/ValoTools.png" Width="35" Height="35" Margin="0,0,10,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="VALOTOOLS" FontFamily="./assets/fonts/#Barlow" FontStretch="Condensed" FontSize="17" FontWeight="Bold" Foreground="#F4F5F6"/>
                    <TextBlock Text="LOCAL CLIENT" FontSize="9" Foreground="{StaticResource Muted}"/>
                </StackPanel>
            </StackPanel>
            <Border Grid.Row="1" Background="#292B30"/>
            <TextBlock Grid.Row="2" Text="KONTROL" FontSize="10" FontWeight="SemiBold" Foreground="#696C74" Margin="12,26,0,12"/>
            <Border Grid.Row="3" Background="#142629" BorderBrush="#235E64" BorderThickness="1" CornerRadius="11" Height="48">
                <Grid>
                    <Border Width="3" Background="{StaticResource Accent}" HorizontalAlignment="Left" CornerRadius="2" Margin="0,11,0,11"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                        <TextBlock Text="◈" Foreground="{StaticResource Accent}" FontSize="18" Margin="0,0,10,0"/>
                        <TextBlock Text="Ajan seçimi" Foreground="#F4F5F6" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
            <StackPanel Grid.Row="5">
                <Border x:Name="UpdateCard" Background="#142124" BorderBrush="#28666B" BorderThickness="1" CornerRadius="13" Padding="13,11" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="MEVCUT SÜRÜM" Foreground="#83D8DE" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="VersionText" Grid.Column="1" Text="v—" Foreground="#F4F5F6" FontFamily="./assets/fonts/#Barlow" FontSize="16" FontWeight="Bold"/>
                        </Grid>
                        <TextBlock x:Name="UpdateText" Text="Güncellemeleri kontrol edebilirsin." Foreground="#9DB5B7" FontSize="10" TextWrapping="Wrap" Margin="0,9,0,9"/>
                        <Button x:Name="UpdateButton" Content="GÜNCELLEMEYİ KONTROL ET" Click="UpdateButton_Click" Height="32" Cursor="Hand" FontSize="9" FontWeight="Bold" Foreground="#F4F5F6" Background="#24686E" BorderThickness="0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="UpdateButtonBorder" Background="{TemplateBinding Background}" CornerRadius="7">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="UpdateButtonBorder" Property="Background" Value="#31848B"/></Trigger>
                                                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>
                <Border Background="#111216" BorderBrush="#282A30" BorderThickness="1" CornerRadius="13" Padding="13,12">
                    <StackPanel>
                        <TextBlock Text="BAĞLANTI" Foreground="#75777E" FontSize="9" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Ellipse x:Name="ConnectionDot" Width="7" Height="7" Fill="#777A82" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="SidebarStatusText" Text="OYUN BEKLENİYOR" FontSize="10" FontWeight="SemiBold" Foreground="#A8ADB3" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock x:Name="PlayerIdentityText" Text="VALORANT oturumu aranıyor" FontSize="10" Foreground="#6E737B"
                                   TextTrimming="CharacterEllipsis" Margin="15,5,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
        <Border Grid.Column="1" Margin="0,10,10,10" Background="#040507" BorderBrush="#1C1D21" BorderThickness="1" CornerRadius="17" ClipToBounds="True">
        <Grid>
        <Grid.RowDefinitions><RowDefinition Height="1"/><RowDefinition Height="88"/><RowDefinition Height="*"/><RowDefinition Height="96"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#25262B"/>

        <Grid Grid.Row="1" Margin="32,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="VALOTOOLS  /  AGENTS" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold"/>
                <TextBlock Text="Ajan kontrolü" Foreground="#F4F5F6" FontFamily="./assets/fonts/#Barlow" FontStretch="Condensed" FontSize="32" FontWeight="Bold" Margin="0,3,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#14161A" BorderBrush="#303238" BorderThickness="1" CornerRadius="18" Padding="14,8" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Grid Width="16" Height="16" Margin="0,0,9,0">
                        <Ellipse x:Name="StatusHalo" Stroke="#36B7C1" StrokeThickness="1" Opacity="0" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="StatusDot" Fill="#36B7C1" Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock x:Name="StatusText" Text="HAZIRLANIYOR" FontSize="11" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="32,8,32,22">
            <Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" CornerRadius="15" BorderBrush="#2C3035" BorderThickness="1" ClipToBounds="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#14191C" Offset="0"/><GradientStop Color="#0F1116" Offset="0.62"/><GradientStop Color="#102024" Offset="1"/></LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition Height="*"/><RowDefinition Height="125"/></Grid.RowDefinitions>
                    <Grid Margin="22,20,22,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="AKTİF AJAN" Foreground="{StaticResource Muted}" FontWeight="SemiBold" FontSize="10"/>
                        <TextBlock Grid.Column="1" Text="01 / PROFILE" Foreground="#686B72" FontSize="9" FontWeight="SemiBold"/>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Ellipse Width="320" Height="320" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.52">
                             <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#28696D" Offset="0"/><GradientStop Color="#153539" Offset="0.48"/><GradientStop Color="#00101417" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
                        </Ellipse>
                        <TextBlock Text="V" FontSize="240" FontWeight="Black" Foreground="#203337" Opacity="0.45" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image x:Name="PreviousPortrait" Stretch="Uniform" Opacity="0"/>
                        <Image x:Name="SelectedPortrait" Stretch="Uniform" Opacity="0">
                            <Image.RenderTransform><TranslateTransform Y="0"/></Image.RenderTransform>
                        </Image>
                    </Grid>
                    <StackPanel Grid.Row="2" Margin="22,0,22,16">
                        <StackPanel Orientation="Horizontal">
                            <Image x:Name="SelectedRoleIcon" Width="15" Height="15" Stretch="Uniform" Margin="0,0,7,0"/>
                            <TextBlock x:Name="SelectedRole" Text="AJAN SEÇ" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="SelectedName" Text="—" FontFamily="./assets/fonts/#Barlow" FontStretch="Condensed" FontSize="43" FontWeight="Bold" Margin="0,2,0,3">
                            <TextBlock.RenderTransform><TranslateTransform Y="0"/></TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock Text="Maç bulunduğunda seçtiğin ajan kilitlenir." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="58"/><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Ajanlar" FontFamily="./assets/fonts/#Barlow" FontStretch="Condensed" FontSize="27" FontWeight="Bold"/>
                        <TextBlock Text="Oynamak istediğin ajanı seç." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,5">
                        <TextBlock x:Name="AgentCount" Text="— AJAN" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold" Margin="0,0,15,0"/>
                        <Button Style="{StaticResource RefreshButtonStyle}" Click="RefreshButton_Click" ToolTip="Ajan listesini yenile"/>
                    </StackPanel>
                </Grid>
                <Border Grid.Row="1" Background="#16171C" BorderBrush="#2B2D33" BorderThickness="1" CornerRadius="10" Height="42" VerticalAlignment="Bottom" Margin="0,0,0,7">
                    <DockPanel Margin="12,0">
                        <TextBlock Text="⌕" FontSize="18" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Grid>
                            <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" Background="Transparent" Foreground="#F4F5F6" BorderThickness="0" CaretBrush="{StaticResource Accent}" FontSize="13" VerticalContentAlignment="Center"/>
                            <TextBlock x:Name="SearchHint" Text="Ajan ara..." Foreground="#777A82" FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Grid>
                    </DockPanel>
                </Border>
                <UniformGrid Grid.Row="2" Columns="5" Height="30" VerticalAlignment="Top" Margin="0,2,0,6">
                    <RadioButton x:Name="AllRoleFilter" Content="TÜMÜ" GroupName="AgentRoles" Tag="" IsChecked="True" Style="{StaticResource RoleChip}" Checked="RoleFilter_Checked"/>
                    <RadioButton Content="DÜELLOCU" GroupName="AgentRoles" Tag="Duelist" Style="{StaticResource RoleChip}" Checked="RoleFilter_Checked"/>
                    <RadioButton Content="ÖNCÜ" GroupName="AgentRoles" Tag="Initiator" Style="{StaticResource RoleChip}" Checked="RoleFilter_Checked"/>
                    <RadioButton Content="KONTROL" GroupName="AgentRoles" Tag="Controller" Style="{StaticResource RoleChip}" Checked="RoleFilter_Checked"/>
                    <RadioButton Content="GÖZCÜ" GroupName="AgentRoles" Tag="Sentinel" Style="{StaticResource RoleChip}" Checked="RoleFilter_Checked"/>
                </UniformGrid>
                <Border Grid.Row="3" Background="#0F1015" BorderBrush="#25262B" BorderThickness="1" CornerRadius="14" Padding="14">
                    <Grid>
                    <ScrollViewer x:Name="AgentScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="AgentScroll_PreviewMouseWheel">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource ModernScrollBar}"/>
                        </ScrollViewer.Resources>
                        <ItemsControl x:Name="AgentItems">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource AgentButton}" Click="Agent_Click" Tag="{Binding}" Margin="0,0,11,11">
                                        <Border Style="{StaticResource Card}" Width="110" Height="124">
                                            <StackPanel Margin="6,7">
                                                <Image Source="{Binding IconUrl}" Width="77" Height="72" Stretch="Uniform"/>
                                                <TextBlock Text="{Binding Name}" Foreground="#F4F5F6" FontWeight="Bold" FontSize="12" TextAlignment="Center" Margin="0,6,0,0"/>
                                                <TextBlock Text="{Binding Role}" Foreground="{StaticResource Muted}" FontSize="9" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="EmptyAgentsText" Text="Bu filtrede ajan bulunamadı." Foreground="{StaticResource Muted}"
                               FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="3" Background="#0F1015" BorderBrush="#25262B" BorderThickness="0,1,0,0" ClipToBounds="True">
            <Grid>
                <Rectangle x:Name="ActivityLine" Fill="{StaticResource Accent}" Width="220" Height="2" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0">
                    <Rectangle.RenderTransform><TranslateTransform X="-240"/></Rectangle.RenderTransform>
                </Rectangle>
                <Grid Margin="30,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="RegionText" Text="BÖLGE  •  VALORANT BEKLENİYOR" Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="11"/>
                        <TextBlock x:Name="DetailText" Text="Ajan listesi yükleniyor..." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/>
                    </StackPanel>
